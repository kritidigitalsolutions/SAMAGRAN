RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
ORDER_DELIVERY_FEE=20

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_PROJECT_ID=your-project-id
