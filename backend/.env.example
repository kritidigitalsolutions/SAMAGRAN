PORT=8000
NODE_ENV=production

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/samagran?retryWrites=true&w=majority
JWT_SECRET=replace_with_strong_secret

FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=https://samagran-admin.vercel.app
CORS_ORIGINS=https://samagran-admin.vercel.app

ADMIN_NAME=Temple Ops
ADMIN_EMAIL=admin@example.com
