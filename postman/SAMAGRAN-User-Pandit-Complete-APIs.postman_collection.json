{
  "info": {
    "name": "SAMAGRAN User + Pandit Complete APIs",
    "description": "Updated collection for current user and pandit flows: auth, profile, booking discovery, user booking flow, and pandit assigned booking actions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "User Auth",
      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Test@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "User Send OTP (Login)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{userPhone}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/send-otp"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "var json = pm.response.json();",
                "if (json && json.data && json.data.otp) pm.environment.set('userOtp', json.data.otp);"
              ]
            }
          }]
        },
        {
          "name": "User Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{userPhone}}\",\n  \"otp\": \"{{userOtp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-otp"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "var json = pm.response.json();",
                "if (json && json.token) pm.environment.set('userToken', json.token);",
                "if (json && json.user && json.user._id) pm.environment.set('userId', json.user._id);"
              ]
            }
          }]
        },
        {
          "name": "User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/user/profile"
          }
        }
      ]
    },
    {
      "name": "Pandit Auth + Profile",
      "item": [
        {
          "name": "Pandit Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{panditPhone}}\",\n  \"fullName\": \"Pandit Test\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/send-otp"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "var json = pm.response.json();",
                "if (json && json.data && json.data.OTP) pm.environment.set('panditOtp', json.data.OTP);"
              ]
            }
          }]
        },
        {
          "name": "Pandit Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{panditPhone}}\",\n  \"otp\": \"{{panditOtp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/verify-otp"
          }
        },
        {
          "name": "Pandit Complete Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{panditPhone}}\",\n  \"fullName\": \"Pandit Test\",\n  \"yearsOfExperience\": 6,\n  \"templeAssociated\": \"Shiv Temple\",\n  \"languagesSpoken\": [\"Hindi\", \"Sanskrit\"],\n  \"address\": {\n    \"line1\": \"Temple Road\",\n    \"city\": \"Varanasi\",\n    \"state\": \"Uttar Pradesh\",\n    \"pinCode\": \"221001\"\n  },\n  \"aadhaar\": {\n    \"number\": \"123412341234\",\n    \"consentGiven\": true\n  },\n  \"serviceTypes\": {\n    \"onlinePooja\": true,\n    \"homeVisit\": true,\n    \"atTemple\": true\n  },\n  \"poojaOfferings\": [\n    {\n      \"name\": \"Griha Shanti Pooja\",\n      \"isSelected\": true,\n      \"durationHours\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/complete-profile"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "var json = pm.response.json();",
                "if (json && json.data && json.data.token) pm.environment.set('panditToken', json.data.token);",
                "if (json && json.data && json.data.pandit && json.data.pandit._id) pm.environment.set('panditId', json.data.pandit._id);"
              ]
            }
          }]
        },
        {
          "name": "Pandit Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{panditToken}}" }],
            "url": "{{baseUrl}}/api/pandit/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Pandit Booking Discovery (User Side)",
      "item": [
        {
          "name": "Get Rituals",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/rituals" }
        },
        {
          "name": "Get Pandits",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/pandits" },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "var json = pm.response.json();",
                "if (json && json.data && json.data.length) pm.environment.set('bookingPanditId', json.data[0]._id);"
              ]
            }
          }]
        },
        {
          "name": "Get Pandit Profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/pandits/{{bookingPanditId}}" }
        },
        {
          "name": "Get Slots",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/slots?panditId={{bookingPanditId}}" }
        }
      ]
    },
    {
      "name": "Pandit Booking (User Actions)",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ritualName\": \"Griha Shanti Pooja\",\n  \"bookingMode\": \"home\",\n  \"panditId\": \"{{bookingPanditId}}\",\n  \"bookingDate\": \"2026-06-20\",\n  \"dateAndTime\": [{ \"date\": \"2026-06-20\", \"time\": \"10:00 AM - 12:00 PM\" }],\n  \"address\": {\n    \"name\": \"Test User\",\n    \"phone\": \"{{userPhone}}\",\n    \"fullAddress\": \"B-245, Shastri Nagar\",\n    \"city\": \"Meerut\",\n    \"state\": \"Uttar Pradesh\",\n    \"pincode\": \"250004\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/pandit-bookings"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "var json = pm.response.json();",
                "if (json && json.data && json.data._id) pm.environment.set('bookingId', json.data._id);",
                "if (json && json.data && json.data.payment && json.data.payment.razorpayOrderId) pm.environment.set('razorpayOrderId', json.data.payment.razorpayOrderId);",
                "if (json && json.bookingIntentToken) pm.environment.set('bookingIntentToken', json.bookingIntentToken);"
              ]
            }
          }]
        },
        {
          "name": "My Pandit Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/pandit-bookings/my"
          }
        },
        {
          "name": "Pandit Booking Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/api/pandit-bookings/{{bookingId}}"
          }
        }
      ]
    },
    {
      "name": "Pandit Assigned Booking (Pandit Actions)",
      "item": [
        {
          "name": "Get Assigned Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{panditToken}}" }],
            "url": "{{baseUrl}}/api/booking-details/bookings"
          }
        },
        {
          "name": "Approve Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{panditToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"samagriType\": \"standard\",\n  \"note\": \"Approved by pandit\"\n}"
            },
            "url": "{{baseUrl}}/api/booking-details/bookings/{{bookingId}}/approve"
          }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{panditToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reasonType\": \"unavailable_personal\",\n  \"note\": \"Not available on this slot\"\n}"
            },
            "url": "{{baseUrl}}/api/booking-details/bookings/{{bookingId}}/reject"
          }
        }
      ]
    }
  ]
}
