{
  "info": {
    "name": "SAMAGRAN - Pandit & User APIs",
    "_postman_id": "samagran-pandit-user-apis",
    "description": "Collection for testing Pandit and User related APIs. Note: Pandit must be `isVerified=true` and `status=active` to appear in booking searches. Complete profile via /api/pandit/auth/complete-profile or verify via admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userToken", "value": "" },
    { "key": "panditToken", "value": "" }
  ],
  "item": [
    {
      "name": "Pandit Auth",
      "item": [
        {
          "name": "Send OTP (Pandit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9000000000\",\n  \"fullName\": \"Pandit Test\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/send-otp"
          }
        },
        {
          "name": "Verify OTP (Pandit)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"9000000000\",\n  \"otp\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/pandit/auth/verify-otp"
          }
        },
        {
          "name": "Get Pandit Profile",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{panditToken}}" } ],
            "url": "{{baseUrl}}/api/pandit/auth/profile"
          }
        },
        {
          "name": "Complete/Edit Pandit Profile (JSON)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{panditToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Pandit Test\",\n  \"yearsOfExperience\": 5,\n  \"templeAssociated\": \"Local Temple\",\n  \"languagesSpoken\": [\"Hindi\", \"Sanskrit\"],\n  \"serviceTypes\": { \"homeVisit\": true, \"onlinePooja\": true },\n  \"address\": { \"line1\": \"Near Temple Road\", \"city\": \"SampleCity\", \"state\": \"SampleState\", \"pinCode\": \"123456\" },\n  \"aadhaar\": { \"number\": \"111122223333\", \"consentGiven\": true }\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/complete-profile"
          }
        },
        {
          "name": "Update Pandit FCM Token",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{panditToken}}" } ],
            "body": { "mode": "raw", "raw": "{ \"fcmToken\": \"SAMPLE_FCM_TOKEN\" }" },
            "url": "{{baseUrl}}/api/pandit/auth/fcm-token"
          }
        }
      ]
    },
    {
      "name": "User Auth",
      "item": [
        {
          "name": "Signup (User)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"phone\": \"9000000001\", \"name\": \"User Test\" }" },
            "url": "{{baseUrl}}/api/auth/signup"
          }
        },
        {
          "name": "Send OTP (User Login)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"phone\": \"9000000001\" }" },
            "url": "{{baseUrl}}/api/auth/send-otp"
          }
        },
        {
          "name": "Verify OTP (User)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{ \"phone\": \"9000000001\", \"otp\": \"123456\" }" },
            "url": "{{baseUrl}}/api/auth/verify-otp"
          }
        },
        {
          "name": "Update User FCM Token",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" } ],
            "body": { "mode": "raw", "raw": "{ \"fcmToken\": \"SAMPLE_FCM_TOKEN\" }" },
            "url": "{{baseUrl}}/api/auth/fcm-token"
          }
        }
      ]
    },
    {
      "name": "Pandit Booking (User)",
      "item": [
        {
          "name": "List Rituals",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/rituals" }
        },
        {
          "name": "List Temples",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/temples" }
        },
        {
          "name": "Search Pandits",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/pandits" }
        },
        {
          "name": "Get Pandit Profile for Booking",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/pandits/{{panditId}}" }
        },
        {
          "name": "Get Pandit Available Slots",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/pandit-bookings/slots?panditId={{panditId}}&days=7" }
        },
        {
          "name": "Create Booking (payment-intent)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ritualName\": \"Ganesh Puja\",\n  \"bookingMode\": \"home\",\n  \"bookingDate\": \"2026-06-01\",\n  \"dateAndTime\": { \"dateAndTime\": [ { \"date\": \"2026-06-01\", \"time\": \"10:00\" } ] },\n  \"panditId\": \"{{panditId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit-bookings/"
          }
        },
        {
          "name": "Confirm Booking Payment (mock)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" } ],
            "body": { "mode": "raw", "raw": "{ \"razorpayOrderId\": \"ORDER_ID\", \"razorpayPaymentId\": \"PAYMENT_ID\", \"razorpaySignature\": \"SIGNATURE\", \"bookingIntentToken\": \"TOKEN_FROM_CREATE\" }" },
            "url": "{{baseUrl}}/api/pandit-bookings/{{bookingId}}/confirm-payment"
          }
        },
        {
          "name": "Get My Pandit Bookings",
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{userToken}}" } ], "url": "{{baseUrl}}/api/pandit-bookings/my" }
        },
        {
          "name": "Get Booking By Id",
          "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{userToken}}" } ], "url": "{{baseUrl}}/api/pandit-bookings/{{bookingId}}" }
        }
      ]
    }
  ]
}
