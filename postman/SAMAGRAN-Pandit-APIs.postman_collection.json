{
  "info": {
    "name": "SAMAGRAN Pandit APIs",
    "description": "Collection to test Pandit auth and onboarding profile APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pandit Auth",
      "item": [
        {
          "name": "1. Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9345678901\",\n  \"fullName\": \"Field Test Pandit\",\n  \"email\": \"pandit@test.com\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.OTP) {",
                  "  pm.environment.set('signupOtp', json.data.OTP);",
                  "}",
                  "pm.environment.set('signupPhone', '9345678901');"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Verify Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{signupPhone}}\",\n  \"otp\": \"{{signupOtp}}\",\n  \"type\": \"signup\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/verify-otp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.environment.set('panditToken', json.data.token);",
                  "}",
                  "if (json && json.data && json.data.pandit && json.data.pandit._id) {",
                  "  pm.environment.set('panditId', json.data.pandit._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{signupPhone}}\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.OTP) {",
                  "  pm.environment.set('loginOtp', json.data.OTP);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Verify Login OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{signupPhone}}\",\n  \"otp\": \"{{loginOtp}}\",\n  \"type\": \"login\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/verify-otp"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.environment.set('panditToken', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{signupPhone}}\",\n  \"type\": \"login\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/resend-otp"
          }
        }
      ]
    },
    {
      "name": "Pandit Profile",
      "item": [
        {
          "name": "6. Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{panditToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pandit/auth/profile"
          }
        },
        {
          "name": "7. Update Profile (JSON)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{panditToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Field Test Pandit\",\n  \"email\": \"pandit@test.com\",\n  \"yearsOfExperience\": 7,\n  \"templeAssociated\": \"Shri Ranganath Swami Temple\",\n  \"languagesSpoken\": [\"Hindi\", \"Sanskrit\"],\n  \"address\": {\n    \"line1\": \"Mathura Road\",\n    \"line2\": \"Near Temple\",\n    \"city\": \"Mathura\",\n    \"state\": \"Uttar Pradesh\",\n    \"pinCode\": \"281001\"\n  },\n  \"aadhaar\": {\n    \"number\": \"123412341234\",\n    \"consentGiven\": true\n  },\n  \"serviceTypes\": {\n    \"onlinePooja\": true,\n    \"homeVisit\": true,\n    \"atTemple\": true,\n    \"travelForSpecialPoojas\": true,\n    \"detectedLocation\": {\n      \"city\": \"Mathura\",\n      \"state\": \"Uttar Pradesh\"\n    },\n    \"serviceDistance\": {\n      \"selected\": \"within10\",\n      \"customKm\": 0\n    },\n    \"outstationAvailability\": {\n      \"withinDistrict\": true,\n      \"withinState\": false,\n      \"anywhereInIndia\": false\n    }\n  },\n  \"poojaOfferings\": [\n    {\n      \"name\": \"Griha Shanti Pooja\",\n      \"isSelected\": true,\n      \"durationHours\": 2,\n      \"travelForSpecialPooja\": false,\n      \"standardSamagri\": true,\n      \"customSamagri\": true\n    },\n    {\n      \"name\": \"Satyanarayan Pooja\",\n      \"isSelected\": true,\n      \"durationHours\": 3,\n      \"travelForSpecialPooja\": true,\n      \"standardSamagri\": true,\n      \"customSamagri\": false\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/pandit/auth/profile"
          }
        },
        {
          "name": "8. Update Profile (Aadhaar Images Form-Data)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{panditToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "fullName",
                  "value": "Field Test Pandit",
                  "type": "text"
                },
                {
                  "key": "yearsOfExperience",
                  "value": "7",
                  "type": "text"
                },
                {
                  "key": "templeAssociated",
                  "value": "Shri Ranganath Swami Temple",
                  "type": "text"
                },
                {
                  "key": "languagesSpoken",
                  "value": "Hindi,Sanskrit",
                  "type": "text"
                },
                {
                  "key": "address",
                  "value": "{\"line1\":\"Mathura Road\",\"line2\":\"Near Temple\",\"city\":\"Mathura\",\"state\":\"Uttar Pradesh\",\"pinCode\":\"281001\"}",
                  "type": "text"
                },
                {
                  "key": "aadhaar",
                  "value": "{\"number\":\"123412341234\",\"consentGiven\":true}",
                  "type": "text"
                },
                {
                  "key": "serviceTypes",
                  "value": "{\"onlinePooja\":true,\"homeVisit\":true,\"atTemple\":true,\"travelForSpecialPoojas\":false,\"detectedLocation\":{\"city\":\"Mathura\",\"state\":\"Uttar Pradesh\"},\"serviceDistance\":{\"selected\":\"within10\",\"customKm\":0},\"outstationAvailability\":{\"withinDistrict\":true,\"withinState\":false,\"anywhereInIndia\":false}}",
                  "type": "text"
                },
                {
                  "key": "poojaOfferings",
                  "value": "[{\"name\":\"Griha Shanti Pooja\",\"isSelected\":true,\"durationHours\":2,\"travelForSpecialPooja\":false,\"standardSamagri\":true,\"customSamagri\":true},{\"name\":\"Satyanarayan Pooja\",\"isSelected\":true,\"durationHours\":3,\"travelForSpecialPooja\":true,\"standardSamagri\":true,\"customSamagri\":false}]",
                  "type": "text"
                },
                {
                  "key": "aadhaarFrontImage",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "aadhaarBackImage",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": "{{baseUrl}}/api/pandit/auth/profile"
          }
        }
      ]
    }
  ]
}
