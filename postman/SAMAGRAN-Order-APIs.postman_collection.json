{
  "info": {
    "name": "SAMAGRAN Order APIs",
    "description": "Order placement flow for cart/direct checkout with COD and Razorpay online payment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Verify OTP (Get Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"9999999999\",\n  \"otp\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "verify-otp"
          ]
        }
      }
    },
    {
      "name": "Create Razorpay Order (Cart/Direct)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deliveryFee\": 20,\n  \"items\": [\n    {\n      \"productId\": \"665000000000000000000111\",\n      \"productType\": \"Item\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"665000000000000000000222\",\n      \"productType\": \"FestivalKit\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/order/payment/razorpay/order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order",
            "payment",
            "razorpay",
            "order"
          ]
        }
      }
    },
    {
      "name": "Place Order - COD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentMethod\": \"COD\",\n  \"deliveryFee\": 20,\n  \"address\": {\n    \"name\": \"Rahul Sharma\",\n    \"phone\": \"9876543210\",\n    \"fullAddress\": \"Flat 402, Baner Road\",\n    \"city\": \"Pune\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"411045\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"665000000000000000000111\",\n      \"productType\": \"Item\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"665000000000000000000222\",\n      \"productType\": \"DefaultKit\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"665000000000000000000333\",\n      \"productType\": \"UserKit\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/order/place",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order",
            "place"
          ]
        }
      }
    },
    {
      "name": "Place Order - Razorpay Online",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentMethod\": \"ONLINE\",\n  \"deliveryFee\": 20,\n  \"address\": {\n    \"name\": \"Rahul Sharma\",\n    \"phone\": \"9876543210\",\n    \"fullAddress\": \"Flat 402, Baner Road\",\n    \"city\": \"Pune\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"411045\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"665000000000000000000111\",\n      \"productType\": \"Item\",\n      \"quantity\": 2\n    }\n  ],\n  \"razorpayOrderId\": \"order_ABC123\",\n  \"razorpayPaymentId\": \"pay_ABC123\",\n  \"razorpaySignature\": \"generated_signature_here\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/order/place",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order",
            "place"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ]
}
