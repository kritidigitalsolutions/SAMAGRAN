{
  "info": {
    "name": "SAMAGRAN Pandit Booking APIs",
    "description": "User flow APIs for pandit appointment booking journey.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "1. Get Rituals",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pandit-bookings/rituals"
          }
        },
        {
          "name": "2. Get Pandits",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pandit-bookings/pandits"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.length) {",
                  "  pm.environment.set('bookingPanditId', json.data[0]._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get Pandit Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pandit-bookings/pandits/{{bookingPanditId}}?ritual=Griha%20Pravesh"
          }
        },
        {
          "name": "4. Get Slots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/pandit-bookings/slots?panditId={{bookingPanditId}}"
          }
        }
      ]
    },
    {
      "name": "Booking (User Token Required)",
      "item": [
        {
          "name": "5. Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ritualName\": \"Griha Pravesh\",\n  \"ritualDescription\": \"Ritual for entering a new home\",\n  \"bookingMode\": \"homeVisit\",\n  \"assignType\": \"choosePandit\",\n  \"panditId\": \"{{bookingPanditId}}\",\n  \"bookingDate\": \"2026-04-20\",\n  \"timeSlot\": {\n    \"label\": \"10:00 AM - 12:00 PM\",\n    \"startTime\": \"10:00\",\n    \"endTime\": \"12:00\"\n  },\n  \"address\": {\n    \"line1\": \"B-245, Shastri Nagar\",\n    \"line2\": \"Near Main Market\",\n    \"city\": \"Meerut\",\n    \"state\": \"Uttar Pradesh\",\n    \"pinCode\": \"250004\"\n  },\n  \"dakshinaAmount\": 61,\n  \"paymentMethod\": \"UPI\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit-bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "  pm.environment.set('bookingId', json.data._id);",
                  "}",
                  "if (json && json.bookingIntentToken) {",
                  "  pm.environment.set('bookingIntentToken', json.bookingIntentToken);",
                  "}",
                  "if (json && json.paymentOrder && json.paymentOrder.razorpayOrder && json.paymentOrder.razorpayOrder.id) {",
                  "  pm.environment.set('razorpayOrderId', json.paymentOrder.razorpayOrder.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingIntentToken\": \"{{bookingIntentToken}}\",\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpayPaymentId\": \"{{razorpayPaymentId}}\",\n  \"razorpaySignature\": \"{{razorpaySignature}}\"\n}"
            },
            "url": "{{baseUrl}}/api/pandit-bookings/{{bookingId}}/confirm-payment"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "  pm.environment.set('bookingId', json.data._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "7. My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pandit-bookings/my"
          }
        },
        {
          "name": "8. Booking Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/pandit-bookings/{{bookingId}}"
          }
        }
      ]
    }
  ]
}
